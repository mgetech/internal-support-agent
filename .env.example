# Copy to .env and fill in real values. .env is gitignored.

# the host port of the compose database. Change it, and the port in DATABASE_URL, if
# another Postgres on this machine already uses 5432
DB_PORT=5432
DATABASE_URL=postgresql://support_agent:support_agent@localhost:${DB_PORT}/support_agent

# the host ports of the compose api and ui. Change them if something else uses 8000 or 8501
API_PORT=8000
UI_PORT=8501

# Azure OpenAI (AI Foundry)
# the v1 API base; no api-version is needed
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=changeme
# capable deployment for the agent loop
AZURE_OPENAI_DEPLOYMENT_AGENT=gpt-5.1
# small deployment for classification and claim extraction
AZURE_OPENAI_DEPLOYMENT_CLASSIFIER=gpt-5.1-mini
AZURE_OPENAI_DEPLOYMENT_EMBEDDING=text-embedding-3-small
# deployment to fall back to when the primary one fails; empty disables fallback
MODEL_FALLBACK_DEPLOYMENT=

# how long a reasoning model thinks before it answers: minimal, low, medium or high.
# One value for each deployment. Leave a value empty if that deployment is not a reasoning
# model (for example gpt-4.1), because it would refuse the setting. The fallback has its own
# value, because it can be a different kind of model than the one it replaces.
REASONING_EFFORT_CLASSIFIER=minimal
REASONING_EFFORT_AGENT=low
REASONING_EFFORT_FALLBACK=

MAX_TOOL_CALLS_PER_REQUEST=8

# minutes to wait before a pending action without a Decision Record is flagged
ORPHAN_GRACE_MINUTES=10

# EUR per 1K tokens, keyed by deployment name; embedding entries carry
# input_per_1k only. Fill in your actual Azure pricing.
PRICE_TABLE_EUR={"gpt-5.1":{"input_per_1k":0.0,"output_per_1k":0.0},"gpt-5.1-mini":{"input_per_1k":0.0,"output_per_1k":0.0},"text-embedding-3-small":{"input_per_1k":0.0}}

RETENTION_DAYS_DECISIONS=1095
RETENTION_DAYS_AUDIT=1095
